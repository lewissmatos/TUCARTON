{
  "expo": {
    "name": "TuCartón",
    "slug": "tucarton",
    "scheme": "tucarton",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-camera"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.tucarton.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tucarton.app"
    }
  }
}
